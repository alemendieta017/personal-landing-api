{
  "kind": "collectionType",
  "collectionName": "buildings",
  "info": {
    "singularName": "building",
    "pluralName": "buildings",
    "displayName": "Building"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string"
    },
    "code": {
      "type": "uid",
      "targetField": "name"
    },
    "address": {
      "type": "string"
    },
    "visits": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::visit.visit",
      "mappedBy": "building"
    }
  }
}
