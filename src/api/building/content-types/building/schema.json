{
  "kind": "collectionType",
  "collectionName": "buildings",
  "info": {
    "singularName": "building",
    "pluralName": "buildings",
    "displayName": "Edificios"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string"
    },
    "code": {
      "type": "uid",
      "targetField": "name"
    },
    "address": {
      "type": "string"
    },
    "type": {
      "type": "enumeration",
      "required": true,
      "default": "building",
      "enum": [
        "building",
        "commercial"
      ]
    },
    "visits": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::visit.visit",
      "mappedBy": "building"
    },
    "photo": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    }
  }
}
